{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aw-app.schema.json",
  "title": "aw-app.json manifest (v1)",
  "description": "Minimal structural validator for the Decoupled Apps Framework manifest (docs/knowledge_base/docs/architecture/decoupled-apps-framework.md, Decision 2). Not the framework's eventual canonical schema \u2014 a local stand-in until Phase 1 publishes schemas/aw-app.schema.json for real.",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "tier",
    "runtime",
    "permissions",
    "contributes"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "inprocess",
        "container"
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "python": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string"
        },
        "pip_requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        },
        "standalone": {
          "type": "object",
          "description": "ADR Decision 4 (adr-app-front-back-routes-dual-mode.md) \u2014 optional, tolerated forward-compatibly. Declares this app is runnable via `python -m <module>` outside the workspace runtime.",
          "required": [
            "module",
            "default_port"
          ],
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1
            },
            "default_port": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(routes:register|routes:local|db:own-tables|commands:install|service:manage|watchdog:tasks|tasks:contribute|agents:contribute|notifications:send|containers:manage|mcp:register-gateway|config:extend:[a-z0-9-]+|net:outbound|fs:workspace-data|secrets:own|ui:code|ui:slots:[a-z0-9.:_-]+)$"
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "routes": {
          "type": "array"
        },
        "commands": {
          "type": "array"
        },
        "system_clis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "installer"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "installer": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "verify": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean",
                    "enum": [
                      false
                    ]
                  }
                ],
                "description": "Command proving the CLI WORKS, not merely that its name is on PATH. Defaults to `<name> --version`. An explicit string is the sole authority (no PATH check runs first), which is how a shell function like nvm can be verified at all. Use false only when no meaningful check exists, so the weakening is explicit rather than the default."
              }
            }
          }
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "body"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Namespaced window id, e.g. browser.main. Runtime validators enforce the <app-id>. prefix."
              },
              "title": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "body": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "managed_app",
                      "declarative",
                      "component"
                    ],
                    "description": "managed_app means the app declares intent only; aw-frontend owns chrome/layout and framework settings, while aw-workspace owns lifecycle/access behavior. declarative renders a windows/*.json widget spec. component is reserved for trusted code-backed windows."
                  },
                  "kind": {
                    "enum": [
                      "browser",
                      "web",
                      "tool",
                      "settings",
                      "dashboard"
                    ],
                    "description": "Frontend rendering hint for managed_app windows."
                  },
                  "path": {
                    "type": "string",
                    "description": "Optional path/query on the app subdomain for managed_app windows."
                  },
                  "app_id": {
                    "type": "string",
                    "description": "Optional target app id; defaults to the contributing app id."
                  },
                  "spec": {
                    "type": "string",
                    "description": "Path to a declarative windows/*.json spec, only for body.type=declarative."
                  },
                  "spec_data": {
                    "type": "object",
                    "description": "Runtime-inlined declarative spec returned by GET /api/apps/-/contributions."
                  }
                }
              }
            }
          }
        },
        "nav": {
          "type": "array"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "settings_panels": {
          "type": "array"
        },
        "frontend": {
          "type": "object"
        },
        "services": {
          "type": "array"
        },
        "containers": {
          "type": "array"
        },
        "extension_points": {
          "type": "array"
        },
        "extensions": {
          "type": "array"
        },
        "mcp": {
          "type": "object",
          "description": "MCP-related declarations. `provides` is the marketplace What-you-get tool list (informational only). `reload_on_save: true` means this app ships its own root mcp.json (scanned directly by aw-mcp-gateway's app-scan) \u2014 a config save then calls the installed mcp-gateway app's POST /reload after your plugin's on_config_saved hook runs. See skills/aw-create-app/SKILL.md \u00a74/\u00a72.",
          "properties": {
            "provides": {
              "type": "array"
            },
            "reload_on_save": {
              "type": "boolean"
            }
          }
        },
        "tasks": {
          "type": "array",
          "description": "Scheduled tasks the app seeds on install. Created once if no task of that NAME exists; never updated afterwards, so the user's own edits always win. Requires the 'tasks:contribute' permission.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Identity of the task. An existing task with this name is left untouched."
              },
              "type": {
                "enum": [
                  "terminal",
                  "agentic_output",
                  "agent_prompt"
                ],
                "default": "terminal"
              },
              "agent_slug": {
                "type": "string",
                "description": "Agents Platform agent the prompt is dispatched to. Required for type 'agent_prompt' — an app shipping both an agent (contributes.agents) and the schedule that drives it names that agent here."
              },
              "reuse_session": {
                "type": "boolean",
                "default": false,
                "description": "For type 'agent_prompt': keep firing into the same Agents Platform session instead of starting a fresh one each run."
              },
              "cli_type": {
                "type": "string"
              },
              "prompt": {
                "type": "string",
                "description": "Required for type 'terminal'."
              },
              "command": {
                "type": "string",
                "description": "Required for type 'agentic_output'."
              },
              "notify_exit_codes": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "Comma-separated, e.g. \"1,2\"."
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    }
                  }
                ],
                "description": "Exit codes that trigger a notification (agentic_output tasks)."
              },
              "schedules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "enabled": {
                "type": "boolean",
                "default": false,
                "description": "Defaults to false \u2014 a seeded schedule is a suggestion the user opts into."
              }
            }
          }
        },
        "agents": {
          "type": "object",
          "description": "Agents Platform objects the app seeds on install. Created once if nothing of that SLUG exists; never updated afterwards and never removed on uninstall, so the user's own edits always win. The four keys are created in the order listed here - an agent references a model, a config and a group by slug. Requires the 'agents:contribute' permission.",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "array",
              "description": "Models the app's agents run on.",
              "items": {
                "type": "object",
                "required": [
                  "slug",
                  "provider",
                  "model_id"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,40}$",
                    "description": "Identity of the object. An existing one with this slug is left untouched."
                  },
                  "provider": {
                    "type": "string",
                    "description": "anthropic | openai | bedrock | cli | echo | fake"
                  },
                  "model_id": {
                    "type": "string"
                  },
                  "display_name": {
                    "type": "string",
                    "description": "Defaults to the slug."
                  },
                  "params": {
                    "type": "object"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            },
            "agent_configs": {
              "type": "array",
              "description": "Reusable permission/volume/MCP bundles agents point at.",
              "items": {
                "type": "object",
                "required": [
                  "slug",
                  "name"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,40}$",
                    "description": "Identity of the object. An existing one with this slug is left untouched."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "mcp_config": {
                    "type": "object"
                  },
                  "extra_volumes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "permissions": {
                    "type": "object"
                  },
                  "auto_compact_threshold_tokens": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  }
                }
              }
            },
            "groups": {
              "type": "array",
              "description": "Named clusters of agents sharing one set of instructions.",
              "items": {
                "type": "object",
                "required": [
                  "slug",
                  "name"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,40}$",
                    "description": "Identity of the object. An existing one with this slug is left untouched."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "instructions": {
                    "type": "string",
                    "description": "Prepended to every member agent's system prompt at run time."
                  },
                  "instructions_file": {
                    "type": "string",
                    "description": "Path inside the package whose contents become `instructions`. Use this instead of inlining a long block into JSON."
                  },
                  "capabilities": {
                    "type": "string"
                  },
                  "kanban_target_status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "agents": {
              "type": "array",
              "description": "The agents themselves - created last, after everything they reference.",
              "items": {
                "type": "object",
                "required": [
                  "slug",
                  "name"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,40}$",
                    "description": "Identity of the object. An existing one with this slug is left untouched."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "system_prompt": {
                    "type": "string"
                  },
                  "system_prompt_file": {
                    "type": "string",
                    "description": "Path inside the package whose contents become `system_prompt`. Use this instead of inlining a long prompt into JSON."
                  },
                  "model_slug": {
                    "type": "string"
                  },
                  "agent_config_slug": {
                    "type": "string"
                  },
                  "group_slug": {
                    "type": "string"
                  },
                  "inherit_from": {
                    "type": "string"
                  },
                  "skill_slugs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "use_cases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "capabilities": {
                    "type": "string"
                  },
                  "tool_specs": {
                    "type": "array"
                  },
                  "params": {
                    "type": "object"
                  },
                  "mcp_config": {
                    "type": "object"
                  },
                  "extra_volumes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "permissions": {
                    "type": "object"
                  },
                  "hidden_from_flow": {
                    "type": "boolean",
                    "default": false
                  },
                  "kanban_target_status": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "icon": {
                    "type": "string"
                  },
                  "color": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "config_visible": {
      "type": "boolean",
      "description": "Defaults to true. Set false to keep a real config_schema (read via ctx.config, e.g. for internal-only settings) WITHOUT showing the Settings gear/entry for it \u2014 not every app has user-facing settings."
    },
    "dependencies": {
      "type": "object"
    },
    "migrations": {
      "type": "object"
    }
  }
}
